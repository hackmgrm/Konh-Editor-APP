{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KonhEditor",
  "version": "0.4.3",
  "identifier": "com.konheditor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "空核编辑器",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      },
      {
        "label": "widget",
        "title": "橦云手帐·挂件",
        "width": 300,
        "height": 400,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: tauri:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http: https: data:; font-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5273 http://127.0.0.1:5273 http: https: ws://localhost:5273 ws://127.0.0.1:5273 wss:; media-src 'self' asset: http: https: blob: data:; frame-src https://www.youtube.com https://player.bilibili.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self';",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/attachments/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "longDescription": "本地优先的写作与个人效率工作台：Markdown 写作、公众号排版与草稿推送，任务与日历、专注计时、桌面提醒和日记。可连接自己的账号服务实现多设备同步。",
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hackmgrm/Konh-Editor-APP/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NUJBNDBFNzRFRkNGMzMKUldRenorOTBEcVJiOUxnTEE2RzlpL20vYm53ZzlHMzJ0cnV1bkI5MmhrUHUwTEdhT2NvSmNOc3AK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
