{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KonhEditor",
  "version": "0.4.0",
  "identifier": "com.konheditor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "空核编辑器",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "longDescription": "本地优先的写作与个人效率工作台：Markdown 写作、公众号排版与草稿推送，任务与日历、专注计时、桌面提醒和日记。可连接自己的账号服务实现多设备同步。",
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hackmgrm/Konh-Editor-APP/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NUJBNDBFNzRFRkNGMzMKUldRenorOTBEcVJiOUxnTEE2RzlpL20vYm53ZzlHMzJ0cnV1bkI5MmhrUHUwTEdhT2NvSmNOc3AK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
